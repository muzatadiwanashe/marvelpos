# MarvelPOS Docker Environment Configuration

# Database Configuration
DB_ROOT_PASSWORD=root
DB_NAME=marvelpos
DB_USER=marvelpos
DB_PASSWORD=marvelpos123
DB_PORT=3306
DB_HOST=mariadb

# Redis Configuration
REDIS_PORT=6379
REDIS_CACHE_URL=redis://redis:6379/1
REDIS_QUEUE_URL=redis://redis:6379/2
REDIS_SOCKETIO_URL=redis://redis:6379/3

# Frappe/ERPNext Configuration
FRAPPE_BRANCH=develop
ERPNEXT_BRANCH=develop
FRAPPE_APP_PORT=8000

# Site Configuration
SITE_NAME=marvelpos.local
SITE_TITLE=MarvelPOS

# Admin User (Initial Setup)
ADMIN_USER=Administrator
ADMIN_PASSWORD=admin123

# Email Configuration (Optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_LOGIN=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# SSL/HTTPS (Optional)
ENABLE_SSL=False
SSL_CERTIFICATE=
SSL_KEY=

# Backup Configuration
BACKUP_INTERVAL=daily
BACKUP_PATH=/home/frappe/backups
